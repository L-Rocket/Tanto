{
    "description": "Caps as Function Key for Weihao (while preserving normal Caps Lock behavior)",
    "manipulators": [
        {
            "description": "Caps Lock alone = normal Caps Lock / input source switch, hold = function layer",
            "from": {
                "key_code": "caps_lock",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "set_variable": {
                        "name": "weihao_caps_layer",
                        "value": 1
                    }
                }
            ],
            "to_after_key_up": [
                {
                    "set_variable": {
                        "name": "weihao_caps_layer",
                        "value": 0
                    }
                }
            ],
            "to_if_alone": [
                {
                    "hold_down_milliseconds": 200,
                    "key_code": "caps_lock"
                }
            ],
            "type": "basic"
        },
        {
            "description": "Cmd+i = Up 5 lines",
            "from": {
                "key_code": "i",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                { "key_code": "up_arrow" },
                { "key_code": "up_arrow" },
                { "key_code": "up_arrow" },
                { "key_code": "up_arrow" },
                { "key_code": "up_arrow" }
            ],
            "type": "basic"
        },
        {
            "description": "Cmd+k = Down 5 lines",
            "from": {
                "key_code": "k",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                { "key_code": "down_arrow" },
                { "key_code": "down_arrow" },
                { "key_code": "down_arrow" },
                { "key_code": "down_arrow" },
                { "key_code": "down_arrow" }
            ],
            "type": "basic"
        },
        {
            "description": "Cmd+j = Previous word",
            "from": {
                "key_code": "j",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_option"]
                }
            ],
            "type": "basic"
        },
        {
            "description": "Cmd+l = Next word",
            "from": {
                "key_code": "l",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_option"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+i = Up",
            "from": {
                "key_code": "i",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "up_arrow" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+k = Down",
            "from": {
                "key_code": "k",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "down_arrow" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+j = Left",
            "from": {
                "key_code": "j",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "left_arrow" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+l = Right",
            "from": {
                "key_code": "l",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "right_arrow" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+w = Next word",
            "from": {
                "key_code": "w",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_option"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+b = Previous word",
            "from": {
                "key_code": "b",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_option"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+u = Line start",
            "from": {
                "key_code": "u",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_command"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+o = Line end",
            "from": {
                "key_code": "o",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_command"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "weihao_caps_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "description": "Caps+h = Select current line",
            "from": {
                "key_code": "h",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_command"]
                },
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_command", "left_shift"]
                }
            ],
            "type": "basic"
        }
    ]
}